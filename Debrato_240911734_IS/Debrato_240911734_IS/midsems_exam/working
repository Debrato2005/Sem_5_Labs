def main():
    ensure_keys()
    records = load_records()

    while True:
        print("\=== UNIVERSITY ===")
        print("1. student")
        print("2. professor")
        print("3. acad")
        print("4. Exit")
        ch = input("Choice: ")

        if ch == "1":
            student_menu(records)
        elif ch == "2":
            professor_menu(records)
        elif ch == "3":
            acad_menu(records)
        elif ch == "4":
            break
        else:
            print("Invalid choice.")


if __name__ == "__main__":
    main()
